pkgname=bookshelf
pkgver=1.1.0
pkgrel=1
pkgdesc="Personal library manager for GNOME"
arch=('any')
url="https://github.com/farukylmz0550/bookshelf-desktop"
license=('GPL-3.0-or-later')
depends=('gtk4' 'libadwaita' 'python' 'python-gobject' 'python-cairo' 'python-matplotlib' 'python-openpyxl' 'python-keyring')
source=()
sha256sums=()

package() {
  install -d "$pkgdir/usr/lib/$pkgname" "$pkgdir/usr/bin" \
    "$pkgdir/usr/share/applications" "$pkgdir/usr/share/metainfo" \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps" \
    "$pkgdir/usr/share/licenses/$pkgname"

  cp -r "$srcdir/src" "$pkgdir/usr/lib/$pkgname/src"
  cp -r "$srcdir/assets" "$pkgdir/usr/lib/$pkgname/assets"
  rm -rf "$pkgdir/usr/lib/$pkgname/assets/screenshots"

  install -m 644 "$srcdir/VERSION" "$pkgdir/usr/lib/$pkgname/VERSION"
  install -m 644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -m 755 "$srcdir/packaging/bookshelf-launcher" "$pkgdir/usr/bin/bookshelf"
  install -m 644 "$srcdir/packaging/io.github.farukylmz0550.BookShelfLegacy.desktop" \
    "$pkgdir/usr/share/applications/"
  install -m 644 "$srcdir/packaging/io.github.farukylmz0550.BookShelfLegacy.metainfo.xml" \
    "$pkgdir/usr/share/metainfo/"
  install -m 644 \
    "$srcdir/assets/icons/hicolor/256x256/apps/io.github.farukylmz0550.BookShelfLegacy.png" \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/"
  install -m 644 \
    "$srcdir/assets/icons/hicolor/scalable/apps/io.github.farukylmz0550.BookShelfLegacy-symbolic.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
}
